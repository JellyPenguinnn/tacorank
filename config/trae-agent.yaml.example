# Safe starter configuration for the separately installed Trae worker.
# TacoRank maps DEEPSEEK_API_KEY to the OpenAI-compatible client only in the
# isolated child environment. The key is never written here.
agents:
  trae_agent:
    enable_lakeview: false
    model: tacorank_coder
    max_steps: 40
    tools:
      - str_replace_based_edit_tool
      - task_done

allow_mcp_servers: []
mcp_servers: {}

model_providers:
  openai:
    provider: openai
    api_key: ""
    base_url: https://api.deepseek.com

models:
  tacorank_coder:
    model_provider: openai
    model: deepseek-v4-flash
    max_tokens: 32768
    temperature: 0
    top_p: 1
    top_k: 0
    max_retries: 3
    parallel_tool_calls: false
